{
  "name": "veterinaria-react",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "api": "node backend/server.cjs",
    "user:create": "node backend/create-user.cjs",
    "test:auth": "node --test backend/server.test.cjs",
    "start": "concurrently -k -n API,WEB -c blue,green \"npm run api\" \"npm run dev\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "bootstrap": "^5.3.3",
    "express": "^4.22.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "json-server": "^0.17.4",
    "typescript": "^5.5.3",
    "vite": "^5.4.8"
  }
}
